  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🚁 DRONE FLIGHT STATE & OVERVIEW",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Arming State",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "expr": "drone_armed", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DISARMED", "color": "green" }, "1": { "text": "ARMED", "color": "red" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Battery Voltage",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "targets": [{ "expr": "drone_battery_voltage", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "min": 9.5,
          "max": 13.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10.8 },
              { "color": "green", "value": 11.4 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Altitude (AGL)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "targets": [{ "expr": "drone_altitude_relative", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "m", "color": { "mode": "palette-classic" } } }
    },
    {
      "id": 4,
      "title": "Heading",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "targets": [{ "expr": "drone_heading", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "degree", "min": 0, "max": 360, "color": { "fixedColor": "cyan", "mode": "fixed" } } }
    },
    {
      "id": 5,
      "title": "RC RSSI Strength",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "targets": [{ "expr": "drone_rssi_percent", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 75 }]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "📊 SENSORS, GYRO RATES & ATTITUDE",
      "type": "row"
    },
    {
      "id": 6,
      "title": "3-Axis Gyroscope Angular Rates (deg/s)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "drone_gyro_rates_degs", "legendFormat": "{{axis}} Rate", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "degree/s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 7,
      "title": "Euler Angles (Attitude)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [{ "expr": "drone_attitude_deg", "legendFormat": "{{type}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "degree", "custom": { "lineWidth": 2 } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 102,
      "title": "🔋 POWER, CELLS & MOTOR OUTPUTS",
      "type": "row"
    },
    {
      "id": 8,
      "title": "Individual Cell Voltages",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 14 },
      "targets": [{ "expr": "drone_cell_voltage", "legendFormat": "Cell {{cell}}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "min": 3.2,
          "max": 4.3,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 3.6 }, { "color": "green", "value": 3.8 }]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Motor PWM Outputs (µs)",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 14 },
      "targets": [{ "expr": "drone_motor_pwm", "legendFormat": "Motor {{motor}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "min": 1000, "max": 2000, "color": { "mode": "palette-classic" } } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "id": 103,
      "title": "💻 RASPBERRY PI SBC HEALTH",
      "type": "row"
    },
    {
      "id": 10,
      "title": "Raspberry Pi CPU Temperature",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 21 },
      "targets": [{ "expr": "sbc_cpu_temp_celsius", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 30,
          "max": 90,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 65 }, { "color": "red", "value": 78 }]
          }
        }
      }
    },
    {
      "id": 11,
      "title": "Raspberry Pi CPU Load",
      "type": "gauge",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 21 },
      "targets": [{ "expr": "sbc_cpu_load_percent", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 85 }]
          }
        }
      }
    }
  ],
