[Unit]
Description=Drone Telemetry Master Companion Server (Radio TX + Web Dashboard + Grid Search)
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/drone_telemetry
ExecStart=/home/pi/drone_telemetry/venv/bin/python3 /home/pi/drone_telemetry/pi/main.py --port /dev/serial0 --baud 115200 --web-port 8000 --radio-rate 5.0
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
